# OpenAI API Key (TTS 기본값, 번역)
OPENAI_API_KEY=sk-your-api-key-here

# ElevenLabs API Key (고품질 TTS)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# DeepL API Key (고품질 번역)
DEEPL_API_KEY=your-deepl-api-key-here

# HeyGen API (AI 아바타 영상 생성)
HEYGEN_API_KEY=your-heygen-api-key-here
HEYGEN_AVATAR_ID=your-talking-photo-id-here
HEYGEN_VOICE_ID=optional-voice-id

# fal.ai API (AI 이미지/비디오 생성)
FAL_KEY=your-fal-ai-key-here

# Kie.ai API (AI 이미지/비디오/음악 생성)
KIE_KEY=your-kie-ai-key-here

# AI Provider 선택 (fal | kie | auto)
AI_PROVIDER=auto
